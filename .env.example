# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงจาก Discord Developer Portal
# https://discord.com/developers/applications -> เลือกแอป

# General Information -> Application ID
APP_ID=

# Bot -> Token (กด Reset Token ถ้าหาไม่เจอ)
DISCORD_TOKEN=

# General Information -> Public Key
DISCORD_PUBLIC_KEY=

# --- rate limit (ไม่บังคับ) ---
# ใส่ที่ Vercel เท่านั้น ไม่ต้องใส่ในเครื่อง ถ้าเว้นว่างไว้ระบบจะไม่จำกัดความถี่เลย
# ได้จาก Upstash Redis -> ปุ่ม Connect (หรือให้ Vercel Marketplace ใส่ให้อัตโนมัติ)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# salt สำหรับ hash id ก่อนเก็บลง Redis ถ้าเว้นว่างจะใช้ DISCORD_TOKEN แทน
RATE_LIMIT_SALT=

# --- ระบบ task (ไม่บังคับ) ---
# ถ้าเว้นว่างไว้ ฟีเจอร์ task จะถูกปิดทั้งชุด บอทเดิมยังทำงานปกติ
MONGODB_URI=

# --- ล็อกอินหน้าเว็บ task ด้วย Discord OAuth2 (ต้องใส่ครบถ้าจะเปิดหน้าเว็บ) ---
# General Information -> Client ID / Client Secret (กด Reset Secret ถ้าหาไม่เจอ)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# กุญแจเซ็น session cookie ต้องยาวอย่างน้อย 32 ตัวอักษร สุ่มด้วย: openssl rand -base64 32
# ถ้าว่างหรือสั้นเกินไป ระบบจะปฏิเสธการล็อกอินทุกครั้งแทนที่จะออก session ที่ปลอมได้
SESSION_SECRET=

# โดเมนจริงของเว็บนี้ (ไม่มี / ปิดท้าย) ใช้คำนวณ redirect_uri กลับมาที่ /api/auth/callback
PUBLIC_BASE_URL=
